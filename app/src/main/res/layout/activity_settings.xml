<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 权限 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="存储权限"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_permission"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_permission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="去授权" />
        </LinearLayout>

        <!-- 视频源 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="视频源文件夹（含 U 盘）"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/source_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btn_add_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="添加视频源文件夹…" />

        <Switch
            android:id="@+id/switch_scan_on_mount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="U 盘插入时自动扫描" />

        <Switch
            android:id="@+id/switch_auto_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="U 盘插入时自动播放（随机）" />

        <Switch
            android:id="@+id/switch_resume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="断点续播" />

        <!-- 解码 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="解码"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_decode_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_decode_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="切换" />
        </LinearLayout>

        <!-- 播放默认值 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="播放"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_default_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_default_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="切换" />
        </LinearLayout>

        <Switch
            android:id="@+id/switch_remember_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="记住上次播放模式（否则用默认值）" />
    </LinearLayout>
</ScrollView>
