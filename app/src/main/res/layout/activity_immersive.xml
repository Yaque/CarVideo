<?xml version="1.0" encoding="utf-8"?>
<!-- 统一抖音式播放页：全屏视频 + 左上收藏/左下更多 + 右上播放列表入口 + 右滑播放列表抽屉 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 可整体滑动动画的内容层 -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="58dp"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:singleLine="true"
            android:shadowColor="#88000000"
            android:shadowRadius="10"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="100dp"
            android:background="@drawable/glass_item"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:shadowColor="#88000000"
            android:shadowRadius="10"
            android:text="上滑/下滑 切换 · 右滑 播放列表 · 单击 暂停/继续"
            android:textColor="#E8EEF9"
            android:textSize="13sp" />

        <!-- 底部进度条（可拖动定位） -->
        <SeekBar
            android:id="@+id/seek_progress"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="88dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:progressTint="#8FB8FF"
            android:thumbTint="#FFFFFF" />

        <!-- 单击暂停时的中央图标（玻璃圆钮，与整体 UI 统一） -->
        <TextView
            android:id="@+id/text_pause"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:background="@drawable/glass_circle"
            android:gravity="center"
            android:shadowColor="#99000000"
            android:shadowRadius="14"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 左上：收藏（抖音式直接在页面上） -->
    <Button
        android:id="@+id/btn_favorite"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="14dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/glass_button"
        android:text="☆"
        android:textColor="#FFD479"
        android:textSize="24sp" />

    <!-- 左下：更多（播放设置弹窗） -->
    <Button
        android:id="@+id/btn_menu"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/glass_button"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="更多"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- 右上：播放列表入口（右滑之外的点击入口） -->
    <Button
        android:id="@+id/btn_playlist"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/glass_button"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="列表"
        android:textColor="#E8EEF9"
        android:textSize="14sp" />

    <!-- 播放列表抽屉（右滑 / 右上按钮进入）：高不透明度玻璃背景保证可读 -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/glass_drawer"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="播放列表"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_close_drawer"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/glass_button"
                android:text="✕"
                android:textColor="#E8EEF9"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 播放范围选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_scope_all"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/glass_button"
                android:text="全部"
                android:textColor="#E8EEF9"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_scope_fav"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/glass_button"
                android:text="收藏"
                android:textColor="#FFD479"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_scope_cat"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button"
                android:text="分类…"
                android:textColor="#B9C9FF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_playlist_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#A9B4C9"
            android:textSize="12sp" />

        <ListView
            android:id="@+id/playlist_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:listSelector="@drawable/glass_item_selector" />
    </LinearLayout>
</FrameLayout>
