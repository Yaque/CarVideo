<?xml version="1.0" encoding="utf-8"?>
<!-- 统一抖音式播放页：全屏视频 + 左上收藏/左下更多 + 右上播放列表入口 + 右滑播放列表抽屉 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!--
      上下滑动页栈（抖音式）：
      中间 = 当前视频内容层，上下 = 邻近视频封面，整体随手指 1:1 位移（跟手）；
      松手按距离/速度决定切换或回弹，切换完成后复位到下一个视频。
    -->
    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 上一个视频封面（滑动时从顶部随动露出） -->
        <ImageView
            android:id="@+id/preview_prev"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="上一个视频封面"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- 下一个视频封面（滑动时从底部随动露出） -->
        <ImageView
            android:id="@+id/preview_next"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="下一个视频封面"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- 切换瞬间的当前视频缩略图（垫在视频层下，新视频首帧前透出，避免黑屏闪动） -->
        <ImageView
            android:id="@+id/preview_current"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="当前视频封面"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- 当前视频内容层（可整体滑动动画） -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- texture_view：视图位移/透明度与画面同步，滑动切换不撕裂、不脱拍 -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:resize_mode="fit"
                app:show_buffering="when_playing"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <!-- 底部渐变遮罩：亮画面上保证文件名/进度条可读 -->
            <View
                android:id="@+id/scrim_bottom"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_gravity="bottom"
                android:background="@drawable/scrim_bottom" />

            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="58dp"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:singleLine="true"
                android:shadowColor="#88000000"
                android:shadowRadius="10"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="100dp"
                android:background="@drawable/glass_chip"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:shadowColor="#88000000"
                android:shadowRadius="10"
                android:text="上滑/下滑 切换 · 右滑 播放列表 · 单击 暂停/继续"
                android:textColor="#E8EEF9"
                android:textSize="13sp" />

            <!-- 底部进度条（可拖动定位） -->
            <SeekBar
                android:id="@+id/seek_progress"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="88dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:progressTint="#8FB8FF"
                android:thumbTint="#FFFFFF" />

            <!-- 单击暂停时的中央图标（玻璃圆钮，与整体 UI 统一） -->
            <TextView
                android:id="@+id/text_pause"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:background="@drawable/glass_circle"
                android:gravity="center"
                android:shadowColor="#99000000"
                android:shadowRadius="14"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <!-- 左上：收藏（抖音式直接在页面上） -->
    <Button
        android:id="@+id/btn_favorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="14dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/glass_button_dark"
        android:minWidth="56dp"
        android:minHeight="56dp"
        android:text="☆"
        android:textColor="#FFD479"
        android:textSize="24sp" />

    <!-- 左下：更多（播放设置弹窗） -->
    <Button
        android:id="@+id/btn_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/glass_button_dark"
        android:minHeight="52dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="更多"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- 右上：播放列表入口（右滑之外的点击入口） -->
    <Button
        android:id="@+id/btn_playlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/glass_button_dark"
        android:minHeight="52dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="列表"
        android:textColor="#E8EEF9"
        android:textSize="14sp" />

    <!-- 播放列表抽屉（右滑 / 右上按钮进入）：高不透明度玻璃背景保证可读 -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/glass_drawer"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="播放列表"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_close_drawer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_button"
                android:minWidth="42dp"
                android:minHeight="42dp"
                android:text="✕"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 播放范围选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_scope_all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/glass_button"
                android:minHeight="42dp"
                android:text="全部"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_scope_fav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/glass_button"
                android:minHeight="42dp"
                android:text="收藏"
                android:textColor="@color/gold"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_scope_cat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/glass_button"
                android:minHeight="42dp"
                android:text="分类…"
                android:textColor="@color/accent_soft"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_playlist_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <ListView
            android:id="@+id/playlist_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:listSelector="@drawable/glass_item_selector" />
    </LinearLayout>
</FrameLayout>
