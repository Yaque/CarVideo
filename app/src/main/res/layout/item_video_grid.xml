<?xml version="1.0" encoding="utf-8"?>
<!-- 视频卡片（网格模块化）：封面图 + 标题 + 元信息，收藏/删除悬浮在封面上 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_item"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/img_thumb"
            android:layout_width="match_parent"
            android:layout_height="@dimen/thumb_height"
            android:background="@drawable/thumb_placeholder"
            android:contentDescription="封面"
            android:scaleType="centerCrop" />

        <Button
            android:id="@+id/btn_favorite"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/glass_button"
            android:focusable="false"
            android:minWidth="40dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="☆"
            android:textColor="#FFD479"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_delete"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/glass_button"
            android:focusable="false"
            android:minWidth="40dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="删除"
            android:textColor="#FF9E9E"
            android:textSize="11sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/text_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:minHeight="44dp"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:singleLine="true"
        android:textColor="#A9B4C9"
        android:textSize="11sp" />
</LinearLayout>
