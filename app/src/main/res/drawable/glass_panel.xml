<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃面板：上亮下暗半透明渐变 + 细描边（配合 GlassBackground 壁纸使用，随昼夜切换） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/glass_panel_top"
        android:endColor="@color/glass_panel_bottom" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
    <corners android:radius="22dp" />
</shape>
