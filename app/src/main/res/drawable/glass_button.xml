<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃按钮（药丸形，按下提亮） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#45FFFFFF"
                android:endColor="#22FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#28FFFFFF"
                android:endColor="#10FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
